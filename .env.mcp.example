# DachuanPro MCP 独立容器运行配置（复制为 .env.mcp 后填写真实值）
NODE_ENV=production
PORT=3010
HOSTNAME=0.0.0.0

# 复用现有 DachuanPro MySQL；MCP 不执行 migration，也不修改业务表结构。
DATABASE_URL=mysql://crm_readwrite_user:change-me@mysql.example.internal:3306/machinery_crm

# Gateway 校验现有 CRM Session，必须复用现有 CRM 的 AUTH_SECRET，不能另生成。
# .env.mcp 必须仅由部署账号读取（Linux 建议 chmod 600），不得提交或发送到模型。
AUTH_SECRET=copy-the-exact-existing-crm-auth-secret
AUTH_URL=https://crm.dachuan.pro

# 鉴权失败日志使用的既有 User.id。无法可信确定用户时，该用户只承担 OperationLog 外键归属。
MCP_AUDIT_USER_ID=replace-with-existing-user-uuid

# FastGPT 到 MCP 的服务身份。只保存 SHA-256，不绑定业务用户。
MCP_API_KEYS_JSON=[{"name":"fastgpt-production","keyHash":"replace-with-64-char-sha256"}]

# 正式模式必须关闭旧的 API Key 绑定业务用户路径；PoC 仅暴露 who_am_i。
MCP_LEGACY_USER_BOUND_AUTH=false
MCP_TOOL_MODE=IDENTITY_POC

# ERP 用户短期断言：Ed25519/EdDSA，默认 10 分钟，允许 300～900 秒。
AGENT_AUTH_ISSUER=https://crm.dachuan.pro
AGENT_AUTH_AUDIENCE=dachuanpro-agent-mcp
AGENT_AUTH_TOKEN_TTL_SECONDS=600
AGENT_AUTH_ACTIVE_KID=replace-with-active-kid
# 支持同时放入多组 kid/publicJwk 进行轮换；仅 active kid 必须含 privateJwk。
# 私钥不得提交、进入日志、浏览器、FastGPT 变量或模型输入；.env.mcp 必须限制文件权限。
AGENT_AUTH_KEYS_JSON=[{"kid":"replace-with-active-kid","publicJwk":{"kty":"OKP","crv":"Ed25519","x":"replace-me"},"privateJwk":{"kty":"OKP","crv":"Ed25519","x":"replace-me","d":"replace-me"}}]

# 多实例 JTI、撤销与限流状态。Compose 内部服务名如下；生产应使用受控 Redis。
AGENT_AUTH_REDIS_URL=redis://dachuanpro-mcp-redis:6379
AGENT_AUTH_REDIS_PREFIX=dachuan:agent-auth

# CRM 内嵌入口只调用本 Gateway；FastGPT Chat Key 仅保存在 Gateway 服务端。
AGENT_GATEWAY_FASTGPT_CHAT_URL=https://fastgpt.dachuan.pro/api/v1/chat/completions
AGENT_GATEWAY_FASTGPT_API_KEY=replace-with-dedicated-fastgpt-chat-key
AGENT_GATEWAY_MAX_REQUEST_BYTES=1048576
AGENT_GATEWAY_RATE_LIMIT_PER_MINUTE=10
AGENT_GATEWAY_ALLOWED_ORIGINS=https://crm.dachuan.pro

# 必填。反向代理必须覆盖 Host/X-Forwarded-Host；含非标准端口时也要写端口。
MCP_ALLOWED_HOSTS=mcp.dachuan.pro

# FastGPT 服务端调用通常不发送 Origin；如浏览器或网关发送 Origin，则必须在此显式允许。
MCP_ALLOWED_ORIGINS=https://fastgpt.dachuan.pro
