      "position": [
        1264,
        -64
      ],
      "id": "53578390-eebe-4510-88d6-9440800ae9cb",
      "name": "Lead Payload SHA256"
    },
    {
      "parameters": {
        "value": "={{ 'lead-idempotency-v2|' + $execution.id + '|' + $json.canonicalPayload.sourceSystem + '|' + $json.canonicalPayload.sourceUrl }}",
        "dataPropertyName": "idempotencyDigest"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1376,
        160
      ],
      "id": "dfcc1460-13da-49ee-a617-54328446194f",
      "name": "Lead Idempotency SHA256"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst allowedBusinessFields = [\n  'companyName',\n  'contactName',\n  'phone',\n  'email',\n  'source',\n  'sourceUrl',\n  'searchKeyword',\n  'aiScore',\n  'profile',\n  'sourceModelVersion',\n  'extractorVersion',\n  'sourceSystem',\n  'externalLeadId',\n];\n\nreturn items.map((item, index) => {\n  const {\n    canonicalPayload,\n    payloadHash,\n    idempotencyDigest,\n  } = item.json;\n\n  if (\n    !canonicalPayload ||\n    typeof canonicalPayload !== 'object' ||\n    Array.isArray(canonicalPayload)\n  ) {\n    throw new Error(`LEAD_CANONICAL_PAYLOAD_INVALID item=${index}`);\n  }\n\n  if (!/^[a-f0-9]{64}$/.test(String(payloadHash ?? ''))) {\n    throw new Error(`LEAD_PAYLOAD_HASH_INVALID item=${index}`);\n  }\n\n  if (!/^[a-f0-9]{64}$/.test(String(idempotencyDigest ?? ''))) {\n    throw new Error(`LEAD_IDEMPOTENCY_DIGEST_INVALID item=${index}`);\n  }\n\n  const idempotencyKey = `lead-v2-${idempotencyDigest}`;\n\n  const finalItem = {\n    idempotencyKey,\n    payloadHash,\n  };\n\n  for (const key of allowedBusinessFields) {\n    const value = canonicalPayload[key];\n\n    // undefined 不进入 3012。\n    if (value === undefined) continue;\n\n    // 3012 的 optional string 不接受 null。\n    if (\n      value === null &&\n      ['contactName', 'phone', 'email'].includes(key)\n    ) {\n      continue;\n    }\n\n    finalItem[key] = value;\n  }\n\n  if (\n    typeof finalItem.companyName !== 'string' ||\n    !finalItem.companyName.trim()\n  ) {\n    throw new Error(`LEAD_COMPANY_NAME_INVALID item=${index}`);\n  }\n\n  if (!['BAIDU_SEARCH', 'MANUAL', 'OTHER'].includes(finalItem.source)) {\n    throw new Error(`LEAD_SOURCE_INVALID item=${index}`);\n  }\n\n  if (\n    idempotencyKey.length < 16 ||\n    idempotencyKey.length > 191 ||\n    !/^[A-Za-z0-9][A-Za-z0-9._:-]*$/.test(idempotencyKey)\n  ) {\n    throw new Error(`LEAD_IDEMPOTENCY_KEY_INVALID item=${index}`);\n  }\n\n  return {\n    json: finalItem,\n    pairedItem: {\n      item: index,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        -64
      ],
      "id": "e2caef40-c23f-42ff-8107-e00b10e560df",
      "name": "Finalize Lead MCP Item"
