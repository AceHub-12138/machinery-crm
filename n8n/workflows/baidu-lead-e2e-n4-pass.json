    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length < 1 || items.length > 20) {\n  throw new Error(`LEAD_UPSERT_ITEMS_COUNT_INVALID count=${items.length}`);\n}\n\nreturn [\n  {\n    json: {\n      items: items.map((item) => item.json),\n    },\n  },\n];"
      },
