        "url": "http://fastgpt-app:3000/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"appId\": \"6a85262812a4dee356cf78d7\",\n  \"chatId\": \"{{ 'N8N-E2E-' + $execution.id + '-' + $itemIndex }}\",\n  \"stream\": false,\n  \"detail\": false,\n  \"variables\": {\n    \"companyName\": \"\",\n    \"searchKeyword\": \"{{ $json.search_keyword }}\",\n    \"searchTitle\": \"{{ $json.title }}\",\n    \"sourceUrl\": \"{{ $json.url }}\",\n    \"sourceDate\": \"{{ $json.date }}\",\n    \"rawContent\": \"{{ $json.content }}\",\n    \"sourceSite\": \"{{ $json.source_site }}\",\n    \"sourceType\": \"{{ $json.source_type }}\"\n  },\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"分析当前搜索线索并输出最终 validatedLead。\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        784,
        -80
      ],
      "id": "816d17e7-a67d-4309-909c-8ae501e4d61e",
      "name": "HTTP Request1",
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_FASTGPT_LEAD_AGENT_CREDENTIAL",
          "name": "FastGPT Lead Agent"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, index) => {\n  const content = item.json?.choices?.[0]?.message?.content;\n\n  if (typeof content !== 'string' || !content.trim()) {\n    throw new Error(`FASTGPT_EMPTY_CONTENT item=${index}`);\n  }\n\n  let validatedLead;\n\n  try {\n    validatedLead = JSON.parse(content.trim());\n  } catch (error) {\n    throw new Error(\n      `FASTGPT_INVALID_JSON item=${index}: ${error.message}`\n    );\n  }\n\n  return {\n    json: {\n      fastgptChatId: item.json.id ?? null,\n      validatedLead\n    },\n    pairedItem: {\n      item: index\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
