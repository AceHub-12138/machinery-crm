      "name": "Lead MCP Payload"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction stableJsonValue(value) {\n  if (Array.isArray(value)) {\n    return value.map(stableJsonValue);\n  }\n\n  if (!value || typeof value !== 'object') {\n    return value;\n  }\n\n  return Object.fromEntries(\n    Object.entries(value)\n      .sort(([left], [right]) => left.localeCompare(right))\n      .map(([key, nested]) => [key, stableJsonValue(nested)])\n  );\n}\n\nfunction normalizedPayload(payload) {\n  return Object.fromEntries(\n    Object.entries(payload)\n      .filter(([, value]) => value !== undefined)\n      .sort(([left], [right]) => left.localeCompare(right))\n      .map(([key, value]) => [key, stableJsonValue(value)])\n  );\n}\n\nreturn items.map((item, index) => {\n  const payload = Object.fromEntries(\n    Object.entries(item.json)\n      .filter(([key]) => !['idempotencyKey', 'payloadHash'].includes(key))\n  );\n\n  const canonicalPayload = normalizedPayload(payload);\n  const canonicalJson = JSON.stringify(canonicalPayload);\n\n  return {\n    json: {\n      canonicalPayload,\n      canonicalJson\n    },\n    pairedItem: {\n      item: index\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        160
      ],
      "id": "9ecec12b-372c-4fdd-974f-807ccb94b344",
      "name": "Canonical Lead Payload"
    },
    {
      "parameters": {
        "value": "={{ $json.canonicalJson }}",
        "dataPropertyName": "payloadHash"
      },
      "type": "n8n-nodes-base.crypto",
