  @@index([supersedesId])
  @@map("erp_monthly_production_plans")
}

model MonthlyProductionPlanItem {
  id                    String                       @id @default(uuid())
  planId                String
  plan                  MonthlyProductionPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId             String
  productModelSnapshot  String
  plannedQuantity       Decimal                      @db.Decimal(10, 2)
  plannedStartDate      DateTime                     @db.Date
  plannedCompletionDate DateTime                     @db.Date
  bomId                 String
  bomVersionSnapshot    String
  convertedQuantity     Decimal                      @default(0) @db.Decimal(10, 2)
  remark                String?                      @db.Text
  createdAt             DateTime                     @default(now())
  materialRequirements  MonthlyMaterialRequirement[]
  productionOrders      ProductionOrder[]

  @@index([planId])
  @@index([productId])
  @@map("erp_monthly_production_plan_items")
}

model MonthlyMaterialRequirement {
  id                  String                    @id @default(uuid())
  planItemId          String
  planItem            MonthlyProductionPlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  materialId          String
  material            Material                  @relation(fields: [materialId], references: [id])
