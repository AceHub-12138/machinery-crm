  planNo       String                      @unique
  planMonth    DateTime                    @db.Date
  name         String
  status       MonthlyProductionPlanStatus @default(DRAFT)
  description  String?                     @db.Text
  version      Int                         @default(1)
  supersedesId String?
  createdById  String
  approvedById String?
  createdAt    DateTime                    @default(now())
  approvedAt   DateTime?
  updatedAt    DateTime                    @updatedAt
