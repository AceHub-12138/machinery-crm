model PurchaseDeliveryBatch {
  id                  String                              @id @default(uuid())
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem                   @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  plannedQuantity     Decimal                             @db.Decimal(10, 2)
  plannedArrivalDate  DateTime?                           @db.Date
  promisedDate        DateTime?                           @db.Date
  shippedQuantity     Decimal                             @default(0) @db.Decimal(10, 2)
  actualShipDate      DateTime?                           @db.Date
  receivedQuantity    Decimal                             @default(0) @db.Decimal(10, 2)
  actualArrivalDate   DateTime?                           @db.Date
  trackingNo          String?
  remark              String?                             @db.Text
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  receiptAllocations  PurchaseDeliveryReceiptAllocation[]

