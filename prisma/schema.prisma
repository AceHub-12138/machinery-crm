  @@map("erp_attachments")
}

model ProcurementConfig {
  id            String   @id @default("default")
  attentionDays Int      @default(7)
  highRiskDays  Int      @default(3)
  urgentDays    Int      @default(1)
  updatedById   String?
  updatedAt     DateTime @updatedAt

  @@map("erp_procurement_config")
}

model ErpNotification {
  id              String    @id @default(uuid())
  notificationKey String    @unique
  userId          String
  title           String
  content         String    @db.Text
  link            String?
  level           String    @default("INFO")
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("erp_notifications")
}

model SalesTarget {
  id          String            @id @default(uuid())
  periodType  SalesTargetPeriod
  periodYear  Int
  periodIndex Int               @default(0)
  metric      SalesTargetMetric
  amount      Decimal           @db.Decimal(14, 2)
  salesUserId String?
  note        String?           @db.Text
  createdById String
  createdBy   User              @relation("SalesTargetCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?             @relation("SalesTargetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([periodType, periodYear, periodIndex, metric, salesUserId], map: "uq_sales_target_scope")
  @@index([periodType, periodYear, periodIndex])
  @@index([salesUserId])
  @@map("sales_targets")
}

enum SalesTargetPeriod {
  MONTH
  YEAR
}

enum SalesTargetMetric {
  CONTRACT_AMOUNT
  PAID_AMOUNT
}

// ==================== 小川 AI 助手（对话记忆，纯新增，不涉及任何业务数据） ====================

model AgentConversation {
  id           String         @id @default(uuid())
  // 双归属：CRM 员工的会话挂 userId，Agent 独立账号的会话挂 agentAccountId；两列恰好一列有值
  userId       String?
  user         User?          @relation(fields: [userId], references: [id])
  agentAccountId String?
  agentAccount AgentAccount?  @relation(fields: [agentAccountId], references: [id])
  title        String         @default("新对话")
  thinkingTier String         @default("standard")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     AgentMessage[]

  @@index([userId, updatedAt])
  @@index([agentAccountId, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id               String            @id @default(uuid())
  conversationId   String
  conversation     AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user | assistant；工具调用过程不单独成行，摘要记录在 assistant 行的 toolSummary
  role             String
  content          String            @db.Text
  // 用户消息随附文件（图片/PDF/CAD），形如 [{url,name,type,size,kind}]；assistant 行为 null
  attachments      Json?
  // 用户对小川回复的反馈：'up'=有帮助，'down'=没帮助，NULL=未评价（段 5 案例沉淀素材）
  feedback         String?
  thinkingTier     String?
  toolSummary      Json?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  error            Boolean?
  createdAt        DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

// ==================== Agent 独立账号体系（纯新增，与 CRM 用户表完全分离：仅能登录 Agent 平台，无任何 CRM/ERP 数据权限） ====================

model AgentAccount {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String
  remark       String?
  // 每日提问上限（按北京时间自然日计数）
  dailyQuota   Int      @default(50)
  // 重置密码时递增，使此前签发的 Agent Cookie 立即失效
  sessionVersion Int    @default(0)
  // 软删除：停用后不可登录，历史数据保留（只加不删原则）
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations AgentConversation[]
  usageDays     AgentUsageDaily[]
  auditLogs     AgentAccountAuditLog[]

  @@map("agent_accounts")
}

// Agent 独立账号的每日提问用量（每账号每天一行，upsert 累加）
model AgentUsageDaily {
  id             String       @id @default(uuid())
  agentAccountId String
  agentAccount   AgentAccount @relation(fields: [agentAccountId], references: [id])
  usageDate      DateTime     @db.Date
  questionCount  Int          @default(0)

  @@unique([agentAccountId, usageDate])
  @@map("agent_usage_daily")
}

// 外部 MCP 服务（智谱联网搜索/网页读取等）：URL 支持 {API_KEY} 占位符；启用后工具全员下发（含 Agent 账号）
model AgentMcpServer {
  id           String   @id @default(uuid())
  name         String
  url          String
  apiKeyCipher String?
  apiKeyHint   String?
  // 停用后工具不再下发，配置保留
  isEnabled    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agent_mcp_servers")
}

// Agent 模型服务配置（多套保存、单套生效；API Key AES-256-GCM 加密存储，页面仅展示尾四位）
model AgentModelConfig {
  id           String   @id @default(uuid())
  name         String
  baseUrl      String
  model        String
  apiKeyCipher String   @db.Text
  // 尾四位展示串，如 "****abcd"
  apiKeyHint   String
  // 全局仅允许一套生效
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agent_model_configs")
}

// Agent 独立账号的工具调用审计（与 MCP/员工同纪律：逐次审计、审计失败不交付结果；
// 因 audit_logs/operation_logs 对 users 表有外键约束，Agent 账号单独落这张纯新增表）
model AgentAccountAuditLog {
  id              String       @id @default(uuid())
  agentAccountId  String
  agentAccount    AgentAccount @relation(fields: [agentAccountId], references: [id])
  requestId       String
  toolName        String
  success         Boolean
  statusCode      Int
  durationMs      Int
  rejectionReason String?
  createdAt       DateTime     @default(now())

  @@index([agentAccountId, createdAt])
  @@map("agent_account_audit_logs")
}

// ==================== 小川知识库（第 2 期段 1：机型参数 / 工艺规则 / 程序模板，纯新增，不涉及业务数据） ====================

model MachineCapability {
  id                String   @id @default(uuid())
  // 机型大类：数控插床 / 数控插齿机 / 插齿插键复合机床 / 五轴加工中心 / 数控键槽铣床 / 普通刨床 / 普通插床
  category          String
  // 型号（唯一键；一行多型号如 B5032/B5040 按原文整行保留）
  model             String   @unique
  fullName          String   @db.Text
  mainObjects       String?  @db.Text
  // 最大插削/刨削长度：原文保留（如 350/320），数值列供筛选（复合值取最大；非插削类机型为 NULL）
  maxStrokeText     String?
  maxStrokeLengthMm Float?
  tableSizeText     String?
  tableLoadKg       Float?
  maxModuleMm       Float?
  maxGearWidthMm    Float?
  maxOuterGearDiaMm Float?
  maxInnerGearText  String?
  ramStrokeText     String?
  powerText         String?
  powerKw           Float?
  maxSpindleRpm     Float?
  travelsText       String?  @db.Text
  ramTiltText       String?
  netWeightText     String?
  dimensionsText    String?  @db.Text
  optionsText       String?  @db.Text
  notSuitableText   String?  @db.Text
  sourceNote        String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("machine_capabilities")
}

model ProcessRuleCard {
  id               String   @id @default(uuid())
  // 规则编号（唯一键，如 R001），重导按编号覆盖更新
  ruleNo           String   @unique
  conditionText    String   @db.Text
  recommendModels  String   @db.Text
  recommendProcess String?  @db.Text
  notRecommended   String?  @db.Text
  rationale        String?  @db.Text
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("process_rule_cards")
}

model NcProgramTemplate {
  id          String   @id @default(uuid())
  // 数控系统：GSK（广数）/ KND（凯恩帝）/ SIEMENS（西门子）
  system      String
  name        String
  machineNote String?
  program     String   @db.Text
  paramNotes  String?  @db.Text
  extraNotes  String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([system, name])
  @@map("nc_program_templates")
}
