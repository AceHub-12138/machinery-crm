  plannedDemandQty    Decimal                   @db.Decimal(12, 4)
  convertedDemandQty  Decimal                   @default(0) @db.Decimal(12, 4)
  calculationSnapshot Json
  createdAt           DateTime                  @default(now())

  @@unique([planItemId, materialId], map: "erp_month_req_item_mat_uq")
  @@index([materialId])
  @@map("erp_monthly_material_requirements")
}

model SupplierDeliveryFollowUp {
  id                      String                 @id @default(uuid())
