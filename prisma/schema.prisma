  purchaseOrderItem       PurchaseOrderItem      @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  followedAt              DateTime
  followedById            String
  supplierContact         String?
  contactMethod           String?
  progress                SupplierProgressStatus
  completionPercent       Int?
  estimatedCompletionDate DateTime?              @db.Date
  estimatedShipDate       DateTime?              @db.Date
  hasDelayRisk            Boolean                @default(false)
  riskReason              String?                @db.Text
  actionPlan              String?                @db.Text
  remark                  String?                @db.Text
  createdAt               DateTime               @default(now())

