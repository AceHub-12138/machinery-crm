  fulfilledQuantity   Decimal           @default(0) @db.Decimal(12, 4)
  createdAt           DateTime          @default(now())

  @@unique([purchaseOrderItemId, purchaseDemandId], map: "erp_po_item_demand_uq")
  @@index([purchaseDemandId])
  @@map("erp_purchase_order_item_sources")
}

model MonthlyProductionPlan {
