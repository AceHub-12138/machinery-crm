server {
    listen 443 ssl http2;
    server_name mcp.dachuan.pro;

    # ssl_certificate /etc/letsencrypt/live/mcp.dachuan.pro/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mcp.dachuan.pro/privkey.pem;

    location = /api/mcp {
        proxy_pass http://127.0.0.1:3010/api/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location = /api/mcp/health {
        proxy_pass http://127.0.0.1:3010/api/mcp/health;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}
