# 本文件仅用于本机/隔离主机验收。复制后的文件不得提交。
COMPOSE_PROJECT_NAME=dachuan-identity-acceptance
IDENTITY_ACCEPTANCE_ENV=isolated

# 固定镜像标签。FastGPT 镜像由 build-fastgpt 脚本从精确提交构建。
CRM_IMAGE=dachuanpro-crm-erp-mcp:1.2.0-identity-acceptance.1
FASTGPT_IMAGE=dachuan-fastgpt:v4.15.1-identity-acceptance.1
FASTGPT_SOURCE_COMMIT=a0aec83f2ae444f5783416d17d0d9d12b7c1dc39

MYSQL_DATABASE=dachuan_identity_acceptance
MYSQL_USER=dachuan_acceptance
MYSQL_PASSWORD=GENERATE_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=GENERATE_MYSQL_ROOT_PASSWORD
DATABASE_URL=mysql://dachuan_acceptance:GENERATE_MYSQL_PASSWORD@mysql:3306/dachuan_identity_acceptance
MCP_QUERY_DATABASE_URL=mysql://dachuan_mcp_read:GENERATE_MCP_QUERY_DB_PASSWORD@mysql:3306/dachuan_identity_acceptance
MCP_AUDIT_DATABASE_URL=mysql://dachuan_mcp_audit:GENERATE_MCP_AUDIT_DB_PASSWORD@mysql:3306/dachuan_identity_acceptance
MCP_COMMAND_DATABASE_URL=mysql://dachuan_lead_writer:GENERATE_MCP_COMMAND_DB_PASSWORD@mysql:3306/dachuan_identity_acceptance
MCP_QUERY_DB_PASSWORD=GENERATE_MCP_QUERY_DB_PASSWORD
MCP_AUDIT_DB_PASSWORD=GENERATE_MCP_AUDIT_DB_PASSWORD
MCP_COMMAND_DB_PASSWORD=GENERATE_MCP_COMMAND_DB_PASSWORD

REDIS_PASSWORD=GENERATE_REDIS_PASSWORD
AGENT_AUTH_REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@identity-redis:6379
AGENT_AUTH_REDIS_PREFIX=dachuan:identity-acceptance

AUTH_SECRET=GENERATE_AUTH_SECRET
CRM_AGENT_ASSERTION_SECRET=GENERATE_AUTH_SECRET
AUTH_URL=http://127.0.0.1:18080
MCP_AUDIT_USER_ID=identity-acceptance-audit
MCP_SERVICE_KEY=GENERATE_MCP_SERVICE_KEY
MCP_SERVICE_KEY_HASH=GENERATE_MCP_SERVICE_KEY_HASH
MCP_API_KEYS_JSON=[{"name":"fastgpt-identity-acceptance","keyHash":"GENERATE_MCP_SERVICE_KEY_HASH"}]
MCP_LEAD_SERVICE_KEY=GENERATE_MCP_LEAD_SERVICE_KEY
MCP_LEAD_SERVICE_KEY_HASH=GENERATE_MCP_LEAD_SERVICE_KEY_HASH
MCP_LEGACY_USER_BOUND_AUTH=false
MCP_TOOL_MODE=IDENTITY_POC
MCP_TOOL_ALLOWLIST=
MCP_ALLOWED_CALLER_ROLES=
MCP_QUERY_TIMEOUT_MS=5000
MCP_ALLOWED_HOSTS=identity-acceptance.local
MCP_ALLOWED_ORIGINS=http://fastgpt:3000

AGENT_AUTH_ISSUER=http://identity-acceptance.crm
AGENT_AUTH_AUDIENCE=dachuanpro-agent-mcp-acceptance
AGENT_AUTH_TOKEN_TTL_SECONDS=600
AGENT_AUTH_ACTIVE_KID=identity-acceptance-1
AGENT_AUTH_KEYS_JSON=GENERATE_AGENT_AUTH_KEYS_JSON
AGENT_AUTH_PUBLIC_KEYS_JSON=GENERATE_AGENT_AUTH_PUBLIC_KEYS_JSON

# Lead E2E 专用 SERVICE 身份。私钥不在本 env 文件中，由 Compose Secret 仅挂载给 FastGPT。
LEAD_SERVICE_ASSERTION_ENABLED=false
LEAD_SERVICE_ASSERTION_APP_IDS=REPLACE_WITH_LEAD_AGENT_APP_ID
LEAD_SERVICE_ASSERTION_ISSUER=http://fastgpt:3000
LEAD_SERVICE_ASSERTION_AUDIENCE=dachuanpro-lead-writer-acceptance
LEAD_SERVICE_ASSERTION_TOKEN_TTL_SECONDS=300
LEAD_SERVICE_ASSERTION_ACTIVE_KID=lead-service-acceptance-1
LEAD_SERVICE_ASSERTION_PRINCIPAL_ID=fastgpt-lead-agent
LEAD_SERVICE_ASSERTION_REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@identity-redis:6379
LEAD_SERVICE_ASSERTION_REDIS_PREFIX=dachuan:lead-service-assertion-acceptance
LEAD_SERVICE_ASSERTION_RATE_LIMIT_PER_MINUTE=30
LEAD_WRITER_AUTH_ISSUER=http://fastgpt:3000
LEAD_WRITER_AUTH_AUDIENCE=dachuanpro-lead-writer-acceptance
LEAD_WRITER_AUTH_TOKEN_TTL_SECONDS=300
LEAD_WRITER_AUTH_KEYS_JSON=GENERATE_LEAD_WRITER_AUTH_KEYS_JSON
LEAD_WRITER_AUTH_REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@identity-redis:6379
LEAD_WRITER_AUTH_REDIS_PREFIX=dachuan:lead-service-assertion-acceptance
LEAD_WRITER_AUTH_RATE_LIMIT_PER_MINUTE=30
LEAD_E2E_FASTGPT_API_KEY=REPLACE_WITH_LEAD_E2E_FASTGPT_APP_KEY
LEAD_E2E_MOCK_URL=http://lead-llm-mock:4010/v1/chat/completions

AGENT_GATEWAY_FASTGPT_CHAT_URL=http://fastgpt:3000/api/v1/chat/completions
# FastGPT 中创建仅供验收的 Agent/API Key 后填写；accept 脚本缺少它会拒绝给出通过结论。
AGENT_GATEWAY_FASTGPT_API_KEY=REPLACE_WITH_ACCEPTANCE_FASTGPT_APP_KEY
AGENT_GATEWAY_MAX_REQUEST_BYTES=1048576
AGENT_GATEWAY_RATE_LIMIT_PER_MINUTE=120
AGENT_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:18080

ACCEPTANCE_USER_PASSWORD=GENERATE_ACCEPTANCE_USER_PASSWORD
ACCEPTANCE_SALES_A_EMAIL=accept-sales-a@dachuan.invalid
ACCEPTANCE_SALES_B_EMAIL=accept-sales-b@dachuan.invalid
ACCEPTANCE_PURCHASE_EMAIL=accept-purchase@dachuan.invalid
ACCEPTANCE_WAREHOUSE_EMAIL=accept-warehouse@dachuan.invalid
ACCEPTANCE_ADMIN_EMAIL=accept-admin@dachuan.invalid

FASTGPT_ROOT_PASSWORD=GENERATE_FASTGPT_ROOT_PASSWORD
FASTGPT_ROOT_KEY=GENERATE_FASTGPT_ROOT_KEY
FASTGPT_TOKEN_KEY=GENERATE_FASTGPT_TOKEN_KEY
FASTGPT_FILE_TOKEN_KEY=GENERATE_FASTGPT_FILE_TOKEN_KEY
FASTGPT_AES_KEY=GENERATE_FASTGPT_AES_KEY
FASTGPT_INVOKE_TOKEN_SECRET=GENERATE_FASTGPT_INVOKE_TOKEN_SECRET
FASTGPT_MONGO_PASSWORD=GENERATE_FASTGPT_MONGO_PASSWORD
FASTGPT_REDIS_PASSWORD=GENERATE_FASTGPT_REDIS_PASSWORD
FASTGPT_MINIO_USER=acceptance-minio
FASTGPT_MINIO_PASSWORD=GENERATE_FASTGPT_MINIO_PASSWORD
FASTGPT_PG_PASSWORD=GENERATE_FASTGPT_PG_PASSWORD
FASTGPT_PLUGIN_TOKEN=GENERATE_FASTGPT_PLUGIN_TOKEN
FASTGPT_SANDBOX_TOKEN=GENERATE_FASTGPT_SANDBOX_TOKEN
FASTGPT_AIPROXY_PG_PASSWORD=GENERATE_FASTGPT_AIPROXY_PG_PASSWORD
FASTGPT_AIPROXY_API_ENDPOINT=http://fastgpt-aiproxy:3000
FASTGPT_AIPROXY_API_TOKEN=GENERATE_FASTGPT_AIPROXY_API_TOKEN

# accept 脚本使用的容器内地址。
ACCEPTANCE_MCP_URL=http://nginx:8080/api/mcp
ACCEPTANCE_FASTGPT_URL=http://nginx:8081
ACCEPTANCE_CRM_URL=http://nginx:8080
