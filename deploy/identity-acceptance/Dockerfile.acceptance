FROM node:20.20.2-bookworm-slim
WORKDIR /workspace
ARG PNPM_VERSION=10.33.4
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    rm -rf /usr/local/lib/node_modules/pnpm; \
    rm -f /usr/local/bin/pnpm /usr/local/bin/pnpx; \
    corepack enable --install-directory /usr/local/bin; \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate; \
    actual_version="$(pnpm --version)"; \
    test "$actual_version" = "$PNPM_VERSION"; \
    echo "PNPM_VERSION_GATE=PASS path=$(command -v pnpm) resolved=$(readlink -f "$(command -v pnpm)") version=$actual_version"
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
RUN node -e "const fs=require('node:fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); p.type='module'; fs.writeFileSync('package.json', JSON.stringify(p));"
COPY prisma ./prisma
COPY scripts ./scripts
COPY src ./src
COPY tsconfig.json next.config.ts vitest.config.ts ./
RUN pnpm exec prisma generate
ENV NODE_ENV=test
