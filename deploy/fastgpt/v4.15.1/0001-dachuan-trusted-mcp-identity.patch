diff --git a/packages/service/test/core/app/dachuanLeadServiceAssertion.test.ts b/packages/service/test/core/app/dachuanLeadServiceAssertion.test.ts
new file mode 100644
index 0000000..fb8f33c
--- /dev/null
+++ b/packages/service/test/core/app/dachuanLeadServiceAssertion.test.ts
@@ -0,0 +1,129 @@
+import { generateKeyPairSync, verify } from 'node:crypto';
+import { describe, expect, it, vi } from 'vitest';
+import {
+  createLeadServiceAssertionIssuer,
+  loadLeadServiceAssertionConfig
+} from '../../../core/app/dachuanLeadServiceAssertion';
+
+const createEnvironment = () => {
+  const serviceKeys = generateKeyPairSync('ed25519');
+  const humanKeys = generateKeyPairSync('ed25519');
+  const privateJwk = serviceKeys.privateKey.export({ format: 'jwk' });
+  const publicJwk = serviceKeys.publicKey.export({ format: 'jwk' });
+  const humanPublicJwk = humanKeys.publicKey.export({ format: 'jwk' });
+  return {
+    serviceKeys,
+    publicJwk,
+    environment: {
+      LEAD_SERVICE_ASSERTION_ENABLED: 'true',
+      LEAD_SERVICE_ASSERTION_APP_IDS: '0123456789abcdef01234567',
+      LEAD_SERVICE_ASSERTION_ISSUER: 'https://fastgpt.internal',
+      LEAD_SERVICE_ASSERTION_AUDIENCE: 'dachuanpro-lead-writer',
+      LEAD_SERVICE_ASSERTION_TOKEN_TTL_SECONDS: '300',
+      LEAD_SERVICE_ASSERTION_ACTIVE_KID: 'lead-service-2026-08',
+      LEAD_SERVICE_ASSERTION_PRIVATE_JWK_JSON: JSON.stringify(privateJwk),
+      LEAD_SERVICE_ASSERTION_PRINCIPAL_ID: 'fastgpt-lead-agent',
+      LEAD_SERVICE_ASSERTION_REDIS_URL: 'redis://lead-assertion.invalid:6379',
+      LEAD_SERVICE_ASSERTION_REDIS_PREFIX: 'dachuan:lead-service-assertion',
+      LEAD_SERVICE_ASSERTION_RATE_LIMIT_PER_MINUTE: '30',
+      AGENT_AUTH_AUDIENCE: 'dachuanpro-human-agent',
+      AGENT_AUTH_REDIS_PREFIX: 'dachuan:human-agent-auth',
+      AGENT_AUTH_PUBLIC_KEYS_JSON: JSON.stringify([
+        { kid: 'human-1', publicJwk: humanPublicJwk }
+      ])
+    }
+  };
+};
+
+describe('Dachuan Lead SERVICE assertion', () => {
+  it('does nothing when the feature is disabled or the application is not allowlisted', async () => {
+    expect(loadLeadServiceAssertionConfig({})).toBeUndefined();
+    const { environment } = createEnvironment();
+    const config = loadLeadServiceAssertionConfig(environment)!;
+    const stateStore = { consume: vi.fn(), register: vi.fn() };
+    const issuer = createLeadServiceAssertionIssuer(config, { stateStore });
+    await expect(issuer.issue('ffffffffffffffffffffffff')).resolves.toBeUndefined();
+    expect(stateStore.consume).not.toHaveBeenCalled();
+  });
+
+  it('issues only SERVICE lead:create claims and registers the jti before returning', async () => {
+    const { environment, serviceKeys } = createEnvironment();
+    const config = loadLeadServiceAssertionConfig(environment)!;
+    const stateStore = {
+      consume: vi.fn().mockResolvedValue(true),
+      register: vi.fn().mockResolvedValue(undefined)
+    };
+    const issuer = createLeadServiceAssertionIssuer(config, {
+      stateStore,
+      now: () => new Date('2026-08-17T00:00:00.000Z'),
+      createJti: () => 'lead-service-jti-0001'
+    });
+
+    const token = await issuer.issue('0123456789abcdef01234567');
+    const [encodedHeader, encodedPayload, encodedSignature] = token!.split('.');
+    const header = JSON.parse(Buffer.from(encodedHeader, 'base64url').toString('utf8'));
+    const payload = JSON.parse(Buffer.from(encodedPayload, 'base64url').toString('utf8'));
+
+    expect(header).toEqual({ alg: 'EdDSA', kid: 'lead-service-2026-08', typ: 'JWT' });
+    expect(payload).toMatchObject({
+      principalType: 'SERVICE',
+      scope: ['lead:create'],
+      iss: 'https://fastgpt.internal',
+      sub: 'fastgpt-lead-agent',
+      aud: 'dachuanpro-lead-writer',
+      jti: 'lead-service-jti-0001'
+    });
+    expect(payload.exp - payload.iat).toBe(300);
+    expect(
+      verify(
+        null,
+        Buffer.from(`${encodedHeader}.${encodedPayload}`),
+        serviceKeys.publicKey,
+        Buffer.from(encodedSignature, 'base64url')
+      )
+    ).toBe(true);
+    expect(stateStore.consume).toHaveBeenCalledWith('fastgpt-lead-agent', 30, 60);
+    expect(stateStore.register).toHaveBeenCalledWith('lead-service-jti-0001', 300);
+  });
+
+  it('rejects shared audience, signing key, Redis namespace and invalid TTL', () => {
+    const { environment, publicJwk } = createEnvironment();
+    expect(() =>
+      loadLeadServiceAssertionConfig({
+        ...environment,
+        LEAD_SERVICE_ASSERTION_AUDIENCE: environment.AGENT_AUTH_AUDIENCE
+      })
+    ).toThrow(/audience must differ/i);
+    expect(() =>
+      loadLeadServiceAssertionConfig({
+        ...environment,
+        AGENT_AUTH_PUBLIC_KEYS_JSON: JSON.stringify([{ kid: 'human-1', publicJwk }])
+      })
+    ).toThrow(/must not reuse/i);
+    expect(() =>
+      loadLeadServiceAssertionConfig({
+        ...environment,
+        LEAD_SERVICE_ASSERTION_REDIS_PREFIX: environment.AGENT_AUTH_REDIS_PREFIX
+      })
+    ).toThrow(/prefix must differ/i);
+    expect(() =>
+      loadLeadServiceAssertionConfig({
+        ...environment,
+        LEAD_SERVICE_ASSERTION_TOKEN_TTL_SECONDS: '901'
+      })
+    ).toThrow(/between 300 and 900/i);
+  });
+
+  it('refuses to issue when the dedicated issuer limit is exhausted', async () => {
+    const { environment } = createEnvironment();
+    const issuer = createLeadServiceAssertionIssuer(loadLeadServiceAssertionConfig(environment)!, {
+      stateStore: {
+        consume: vi.fn().mockResolvedValue(false),
+        register: vi.fn()
+      }
+    });
+    await expect(issuer.issue('0123456789abcdef01234567')).rejects.toThrow(
+      /rate limit exceeded/i
+    );
+  });
+});
