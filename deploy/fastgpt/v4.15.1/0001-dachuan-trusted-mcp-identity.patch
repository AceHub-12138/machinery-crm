new file mode 100644
index 0000000..cd15464
--- /dev/null
+++ b/packages/service/core/app/dachuanLeadServiceAssertion.ts
@@ -0,0 +1,245 @@
+import { createHash, createPrivateKey, randomUUID, sign, type JsonWebKey } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import Redis from 'ioredis';
+
+type Environment = Record<string, string | undefined>;
+
+export type LeadServiceAssertionConfig = {
+  appIds: Set<string>;
+  issuer: string;
+  audience: string;
+  ttlSeconds: number;
+  activeKid: string;
+  privateJwk: JsonWebKey;
+  principalId: string;
+  redisUrl: string;
+  redisPrefix: string;
+  rateLimitPerMinute: number;
+};
+
+export type LeadServiceAssertionStateStore = {
+  consume(subject: string, limit: number, windowSeconds: number): Promise<boolean>;
+  register(jti: string, ttlSeconds: number): Promise<void>;
+};
+
+const required = (environment: Environment, name: string) => {
+  const value = String(environment[name] || '').trim();
+  if (!value) throw new Error(`${name} is required`);
+  return value;
+};
+
+const integer = (
+  environment: Environment,
+  name: string,
+  minimum: number,
+  maximum: number,
+  fallback: number
+) => {
+  const value = Number(environment[name] || fallback);
+  if (!Number.isInteger(value) || value < minimum || value > maximum) {
+    throw new Error(`${name} must be between ${minimum} and ${maximum}`);
+  }
+  return value;
+};
+
+const json = (value: string, name: string): unknown => {
+  try {
+    return JSON.parse(value);
+  } catch {
+    throw new Error(`${name} must be valid JSON`);
+  }
+};
+
+const normalizedPrefix = (value: string, name: string) => {
+  const normalized = value.trim().replace(/:+$/, '');
+  if (!normalized) throw new Error(`${name} is required`);
+  return normalized;
+};
+
+export const loadLeadServiceAssertionConfig = (
+  environment: Environment = process.env
+): LeadServiceAssertionConfig | undefined => {
+  if (String(environment.LEAD_SERVICE_ASSERTION_ENABLED || 'false').toLowerCase() !== 'true') {
+    return undefined;
+  }
+
+  const appIds = new Set(
+    required(environment, 'LEAD_SERVICE_ASSERTION_APP_IDS')
+      .split(',')
+      .map((item) => item.trim())
+      .filter(Boolean)
+  );
+  if (appIds.size === 0 || [...appIds].some((appId) => !/^[a-f\d]{24}$/i.test(appId))) {
+    throw new Error('LEAD_SERVICE_ASSERTION_APP_IDS must contain FastGPT application IDs');
+  }
+
+  const audience = required(environment, 'LEAD_SERVICE_ASSERTION_AUDIENCE');
+  if (audience === required(environment, 'AGENT_AUTH_AUDIENCE')) {
+    throw new Error('Lead SERVICE assertion audience must differ from human assertion audience');
+  }
+
+  const privateJwkInput = String(environment.LEAD_SERVICE_ASSERTION_PRIVATE_JWK_JSON || '').trim();
+  const privateJwkFile = String(environment.LEAD_SERVICE_ASSERTION_PRIVATE_JWK_FILE || '').trim();
+  if (!!privateJwkInput === !!privateJwkFile) {
+    throw new Error('Configure exactly one Lead SERVICE assertion private JWK source');
+  }
+  const privateJwk = json(
+    privateJwkInput || readFileSync(privateJwkFile, 'utf8'),
+    'LEAD_SERVICE_ASSERTION_PRIVATE_JWK_JSON'
+  ) as JsonWebKey;
+  if (
+    privateJwk.kty !== 'OKP' ||
+    privateJwk.crv !== 'Ed25519' ||
+    typeof privateJwk.x !== 'string' ||
+    typeof privateJwk.d !== 'string'
+  ) {
+    throw new Error('LEAD_SERVICE_ASSERTION_PRIVATE_JWK_JSON must be a private Ed25519 JWK');
+  }
+
+  const humanKeys = json(
+    required(environment, 'AGENT_AUTH_PUBLIC_KEYS_JSON'),
+    'AGENT_AUTH_PUBLIC_KEYS_JSON'
+  );
+  if (!Array.isArray(humanKeys) || humanKeys.length === 0) {
+    throw new Error('AGENT_AUTH_PUBLIC_KEYS_JSON must contain public Ed25519 keys');
+  }
+  if (
+    humanKeys.some(
+      (entry) =>
+        entry &&
+        typeof entry === 'object' &&
+        (entry as { publicJwk?: JsonWebKey }).publicJwk?.x === privateJwk.x
+    )
+  ) {
+    throw new Error('Lead SERVICE signing key must not reuse a human assertion key');
+  }
+
+  const redisPrefix = normalizedPrefix(
+    required(environment, 'LEAD_SERVICE_ASSERTION_REDIS_PREFIX'),
+    'LEAD_SERVICE_ASSERTION_REDIS_PREFIX'
+  );
+  if (
+    redisPrefix ===
+    normalizedPrefix(required(environment, 'AGENT_AUTH_REDIS_PREFIX'), 'AGENT_AUTH_REDIS_PREFIX')
+  ) {
+    throw new Error('Lead SERVICE assertion Redis prefix must differ from human assertion prefix');
+  }
+
+  const principalId = required(environment, 'LEAD_SERVICE_ASSERTION_PRINCIPAL_ID');
+  if (!/^[A-Za-z0-9][A-Za-z0-9._:-]{2,190}$/.test(principalId)) {
+    throw new Error('LEAD_SERVICE_ASSERTION_PRINCIPAL_ID must be a stable service identifier');
+  }
+
+  return {
+    appIds,
+    issuer: required(environment, 'LEAD_SERVICE_ASSERTION_ISSUER'),
+    audience,
+    ttlSeconds: integer(
+      environment,
+      'LEAD_SERVICE_ASSERTION_TOKEN_TTL_SECONDS',
+      300,
+      900,
+      300
+    ),
+    activeKid: required(environment, 'LEAD_SERVICE_ASSERTION_ACTIVE_KID'),
+    privateJwk,
+    principalId,
+    redisUrl: required(environment, 'LEAD_SERVICE_ASSERTION_REDIS_URL'),
+    redisPrefix,
+    rateLimitPerMinute: integer(
+      environment,
+      'LEAD_SERVICE_ASSERTION_RATE_LIMIT_PER_MINUTE',
+      1,
+      10000,
+      30
+    )
+  };
+};
+
+const digest = (value: string) => createHash('sha256').update(value).digest('hex');
+const base64url = (value: object) => Buffer.from(JSON.stringify(value)).toString('base64url');
+
+export const createRedisLeadServiceAssertionStateStore = (
+  redisUrl: string,
+  redisPrefix: string
+): LeadServiceAssertionStateStore => {
+  const redis = new Redis(redisUrl, {
+    lazyConnect: true,
+    maxRetriesPerRequest: 1,
+    enableReadyCheck: true
+  });
+  const ready = async () => {
+    if (redis.status === 'wait') await redis.connect();
+    return redis;
+  };
+
+  return {
+    async consume(subject, limit, windowSeconds) {
+      const client = await ready();
+      const count = await client.eval(
+        "local n=redis.call('INCR',KEYS[1]); if n==1 then redis.call('EXPIRE',KEYS[1],ARGV[1]); end; return n",
+        1,
+        `${redisPrefix}:rate:${digest(subject)}`,
+        String(windowSeconds)
+      );
+      return Number(count) <= limit;
+    },
+    async register(jti, ttlSeconds) {
+      const client = await ready();
+      await client.set(`${redisPrefix}:jti:${digest(jti)}`, 'active', 'EX', ttlSeconds);
+    }
+  };
+};
+
+export const createLeadServiceAssertionIssuer = (
+  config: LeadServiceAssertionConfig,
+  options: {
+    stateStore?: LeadServiceAssertionStateStore;
+    now?: () => Date;
+    createJti?: () => string;
+  } = {}
+) => {
+  const signingKey = createPrivateKey({ key: config.privateJwk, format: 'jwk' });
+  const stateStore =
+    options.stateStore ??
+    createRedisLeadServiceAssertionStateStore(config.redisUrl, config.redisPrefix);
+  const now = options.now ?? (() => new Date());
+  const createJti = options.createJti ?? randomUUID;
+
+  return {
+    async issue(appId: string) {
+      if (!config.appIds.has(appId)) return undefined;
+      if (!(await stateStore.consume(config.principalId, config.rateLimitPerMinute, 60))) {
+        throw new Error('Lead SERVICE assertion issuance rate limit exceeded');
+      }
+      const issuedAt = Math.floor(now().getTime() / 1000);
+      const expiresAt = issuedAt + config.ttlSeconds;
+      const jti = createJti();
+      const header = base64url({ alg: 'EdDSA', kid: config.activeKid, typ: 'JWT' });
+      const payload = base64url({
+        principalType: 'SERVICE',
+        scope: ['lead:create'],
+        iss: config.issuer,
+        sub: config.principalId,
+        aud: config.audience,
+        iat: issuedAt,
+        nbf: issuedAt,
+        exp: expiresAt,
+        jti
+      });
+      const signingInput = `${header}.${payload}`;
+      const signature = sign(null, Buffer.from(signingInput), signingKey).toString('base64url');
+      await stateStore.register(jti, config.ttlSeconds);
+      return `${signingInput}.${signature}`;
+    }
+  };
+};
+
+let issuer: ReturnType<typeof createLeadServiceAssertionIssuer> | undefined;
+
+export const issueLeadServiceAssertionForApp = async (appId: string) => {
+  const config = loadLeadServiceAssertionConfig();
+  if (!config) return undefined;
+  issuer ??= createLeadServiceAssertionIssuer(config);
+  return issuer.issue(appId);
+};
