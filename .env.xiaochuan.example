# 小川助手（平台内 Agent）环境变量示例
# 复制到服务器 .env 并按实际值填写；XIAOCHUAN_LLM_API_KEY 是必填项，其余有默认值。

# ---- 必填 ----
# 硅基流动 API Key（仅服务端使用，绝不写入前端或日志）
XIAOCHUAN_LLM_API_KEY=

# ---- 可选（默认值见注释） ----
# 大脑接口地址（OpenAI 兼容）
# XIAOCHUAN_LLM_BASE_URL=https://api.siliconflow.cn/v1
# 大脑模型（当前主力：Pro/moonshotai/Kimi-K2.6；直接写 moonshotai/Kimi-K2.6 会报 30004 私有模型）
# XIAOCHUAN_LLM_MODEL=Pro/moonshotai/Kimi-K2.6
# 引擎最多几轮“思考→调工具”循环（默认 6，最大 12）
# XIAOCHUAN_MAX_TOOL_ITERATIONS=6
# 单次大脑请求超时毫秒（默认 30000）
# XIAOCHUAN_REQUEST_TIMEOUT_MS=30000
# 一次提问总体超时毫秒（默认 90000）
# XIAOCHUAN_OVERALL_TIMEOUT_MS=90000
# 每用户每分钟提问上限（默认 10）
# XIAOCHUAN_RATE_LIMIT_PER_MINUTE=10
# 历史消息携带条数上限（默认 20）
# XIAOCHUAN_HISTORY_MESSAGE_LIMIT=20

# ---- 三档思考菜单覆盖（JSON，默认值已内置，一般不用改） ----
# enableThinking 控制深度思考开关：false 时回答极快且成本约千分之一（适合小川快跑档）
# XIAOCHUAN_TIER_FAST_JSON={"maxOutputTokens":1500,"enableThinking":false,"styleDirective":"……"}
# XIAOCHUAN_TIER_STANDARD_JSON={"maxOutputTokens":4096,"enableThinking":true,"styleDirective":"……"}
# XIAOCHUAN_TIER_DEEP_JSON={"maxOutputTokens":8192,"enableThinking":true,"styleDirective":"……"}

# —— 视觉读图（2026-09 一期新增，可选）——
# 图片/PDF 页面识别专用模型。缺省回落主模型；但 Kimi-K2.6 Pro 渠道对大图生成过慢会超时，
# 建议单独配置高速视觉模型（对话大脑仍是 XIAOCHUAN_LLM_MODEL 不变）：
# XIAOCHUAN_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# 单图读图超时（毫秒），默认 90000，上限 180000：
# XIAOCHUAN_VISION_TIMEOUT_MS=120000
